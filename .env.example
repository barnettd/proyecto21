# Server-only. Leave empty to run from content/seed.ts.
# On Vercel these come from the Supabase integration as STORAGE_SUPABASE_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Emergency override when Supabase isn't set up (DB settings.force_active_day wins otherwise).
# Leave unset in production: it overrides the schedule.
FORCE_ACTIVE_DAY=

# Email notice when she submits (optional; no email is sent unless both are set).
RESEND_API_KEY=
P21_NOTIFY_EMAIL=
# Optional sender override; defaults to Resend's test sender.
P21_NOTIFY_FROM=
